{
  "name": "lap-cerebro",
  "productName": "LAP Cerebro",
  "version": "2.19.4",
  "description": "Cerebro del estudio LAP: proyectos, planes de entregables, cronogramas personales, reuniones, comités y quién trabaja en qué.",
  "author": "Left Angle Partnership",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "vendor": "node scripts/vendor.js",
    "dist": "electron-builder --win nsis --x64",
    "bundle-server": "node scripts/server-bundle.js"
  },
  "build": {
    "appId": "com.laparq.cerebro",
    "productName": "LAP Cerebro",
    "artifactName": "LAP-Cerebro-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "host.js",
      "bubble.js",
      "bubble-preload.js",
      "respaldo.js",
      "alerta.js",
      "alerta-preload.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "LAP Cerebro",
      "language": "3082"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Diegondre18",
        "repo": "REA",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "server-bundle",
        "to": "servidor",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "pocketbase": "0.28.1",
    "@fontsource/hanken-grotesk": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "preact": "10.29.8",
    "htm": "3.1.1"
  }
}
